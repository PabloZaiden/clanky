{
  "name": "@pablozaiden/clanky",
  "description": "Clanky is a web and REST service used to control and manage coding-agent tasks",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts serve",
    "dev:server": "bun run dev",
    "start": "bun src/index.ts serve",
    "start:server": "bun run start",
    "build": "bun scripts/run-build.ts",
    "build:client": "bun src/build-client.ts",
    "build:client-sdk": "bun src/build-client-sdk.ts",
    "build:pages": "bun src/build-pages.ts",
    "build:apple:assets": "bun scripts/build-apple.ts assets",
    "build:apple:macos": "bun scripts/build-apple.ts macos",
    "build:apple:ios": "bun scripts/build-apple.ts ios",
    "generate:macos-signing-cert": "bun scripts/generate-macos-signing-cert.ts",
    "release": "bun scripts/release.ts",
    "release:metadata": "bun scripts/release-metadata.ts",
    "release:metadata:check": "bun scripts/release-metadata.ts check",
    "release:metadata:generate": "bun scripts/release-metadata.ts generate-installer",
    "test": "bun scripts/run-tests.ts all",
    "test:mesh": "bun scripts/run-tests.ts mesh",
    "typecheck": "mkdir -p .cache/tsc && bunx tsc --noEmit --pretty false --incremental --tsBuildInfoFile .cache/tsc/build.tsbuildinfo"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.28",
    "@modelcontextprotocol/server": "2.4.0",
    "@monaco-editor/react": "4.7.0",
    "@noble/hashes": "2.4.0",
    "@opencode/client": "2.1.4",
    "@pablozaiden/webapp": "github:PabloZaiden/webapp#02d7729768ee87d0e9a2356e3c6cc2606a8037ff",
    "@peculiar/x509": "2.2.0",
    "@tailwindcss/typography": "0.5.20",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "bun-plugin-tailwind": "0.1.2",
    "css-tree": "3.2.1",
    "franc-min": "6.2.0",
    "highlight.js": "11.12.0",
    "ipaddr.js": "2.5.0",
    "mermaid": "12.2.0",
    "monaco-editor": "0.57.0",
    "png-to-ico": "3.0.2",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "reflect-metadata": "0.2.2",
    "remark-gfm": "4.0.1",
    "saxes": "6.0.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/bun": "1.4.4",
    "@types/css-tree": "3.2.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
